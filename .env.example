# Subtitles Project - Environment Configuration

# Required
DEEPL_API_KEY=yuor_deepl_api_key_here

# KEY MCP
Context7=your_mcp_key_here

# Optional - Defaults are reasonable for most use cases
OLLAMA_HOST=http://localhost:11434          # Local Ollama instance
OLLAMA_MODEL=qwen2.5:14b                    # Model for refinement correction
WHISPER_MODEL=large-v3                      # Whisper model (~3GB)
WHISPER_AUTO_DOWNLOAD=true                  # Auto-download model if not found
WHISPER_MODEL_ROOT=/tmp/whisper-models      # Directory for whisper models
MAX_UPLOAD_MB=5121                           # Max video upload size in MB
HOST=localhost                               # Web server host
PORT=3333                                   # Web server port

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true

# TESTS
video_path=\\wsl.localhost\Ubuntu\home\spike\subtitles_project\tmp\example.mp4

subtitle_path=/home/spike/subtitles_project/tmp/example.en.srt

REFERENCE_JSON_PATH=/home/spike/subtitles_project/tmp/reference.json


MAX_TEXT_ERROR_RATE=0.25

# Teste de Validação
VTT_PATH=/home/spike/subtitles_project/tmp/example.en.srt
REFERENCE_JSON_PATH=/home/spike/subtitles_project/tmp/reference.json
VIDEO_URL=file:///home/spike/subtitles_project/tmp/example.mp4

# Final Test Configuration
VTT_PATH=/home/spike/subtitles_project/tmp/example.en.srt
REFERENCE_JSON_PATH=/home/spike/subtitles_project/tmp/reference.json
VIDEO_URL=file:///home/spike/subtitles_project/tmp/example.mp4
