# Configuração do ambiente para o projeto

# Servidor Web
PORT=3333
HOST=localhost

# Logs
LOG_LEVEL=info

# Clave de seguridad (generar con: openssl rand -hex 32)
APP_KEY=base64 -g 0 | tr -d '\n'

# Modo del entorno
NODE_ENV=development

# API Keys
DEEPL_API_KEY=

# Ollama para refinar transcripciones
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Modelo Whisper para transcripción
WHISPER_MODEL=large-v3

# Ruta de modelos (o usar la variable WHISPER_MODEL_ROOT)
WHISPER_MODEL_ROOT=tmp/whisper-models

# Tamaño máximo de subida en MB
MAX_UPLOAD_MB=500
